{
  "name": "daily-tracker",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js src/lib/*.test.js desktop/*.test.cjs",
    "desktop": "electron .",
    "package:desktop": "npm run build && electron-builder --config desktop/electron-builder.cjs --win nsis --x64",
    "test:ui": "node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "main": "desktop/main.cjs",
  "description": "Momentum — your personal daily tracker",
  "author": "Jackiv Garg"
}
